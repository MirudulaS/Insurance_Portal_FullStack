# Base URL of the future Express REST API.
# During the frontend-only phase this is unused (mock services are active),
# but the axios client is already wired to read it so switching to the real
# backend later only requires changing USE_MOCK below (and this file, if needed).
VITE_API_BASE_URL=http://localhost:5000/api

# Base URL used to build absolute Socket.IO connection URL later.
VITE_SOCKET_URL=http://localhost:5000
